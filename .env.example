# Lấy từ https://my.telegram.org
API_ID=your_api_id
API_HASH=your_api_hash

# Số điện thoại Telegram (format quốc tế, ví dụ: +84912345678)
PHONE_NUMBER=+84xxxxxxxxx

# Server config
HOST=127.0.0.1
PORT=8888

# Timezone
TIMEZONE=Asia/Ho_Chi_Minh

# API key for dashboard auth (REQUIRED). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SECRET_KEY=your_secret_key_here
