# Lấy từ https://my.telegram.org
API_ID=your_api_id
API_HASH=your_api_hash

# Số điện thoại Telegram (format quốc tế, ví dụ: +84912345678)
PHONE_NUMBER=+84xxxxxxxxx

# Server config
HOST=127.0.0.1
PORT=8888

# Timezone
TIMEZONE=Asia/Ho_Chi_Minh

# API key for dashboard auth (REQUIRED). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SECRET_KEY=your_secret_key_here

# Command Bot credentials (recommended; takes precedence over legacy DB settings)
# Never commit real values. Legacy command_bot_token/admin_ids settings remain fallback only.
COMMAND_BOT_TOKEN=
COMMAND_BOT_ADMIN_IDS=123456789,987654321

# Cloudflare Access (9router qua Tunnel) - chi gui toi dung host nay
CF_ACCESS_HOST=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
